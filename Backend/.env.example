NODE_ENV=development
PORT=5000

# Supabase Postgres. On Render use the *Session pooler* connection string
# (Supabase dashboard > Connect), because the direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Storage (product images, homepage banners). Server only, never ship to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

CORS_ORIGINS=http://localhost:5173,https://smoke-wholesale.vercel.app
SHIPPING_FEE=10

# --- Email (SMTP) ---------------------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords> (needs 2-Step Verification)
# Until SMTP_HOST is set, emails are stored in the email_outbox table and printed in the dev console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Smoke Wholesale <you@gmail.com>"
# Frontend address used in email links
APP_URL=http://localhost:5173
APP_NAME=Smoke Wholesale

# --- Background jobs -------------------------------------------------------------
# Scheduled email reports and daily alerts run inside the API. Set to false to turn them off on a server.
SCHEDULER_ENABLED=true
# How often due reports are checked (ms)
SCHEDULER_INTERVAL_MS=60000
