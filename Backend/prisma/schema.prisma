  reason         String         @db.VarChar(64)
  customer_notes String?
  staff_notes    String?
  resolution     String?        @db.VarChar(32)
  warehouse_id   BigInt?
  credit_note_id BigInt?
  approved_at    DateTime?      @db.Timestamptz(6)
  received_at    DateTime?      @db.Timestamptz(6)
  closed_at      DateTime?      @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  companies      companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders         orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  warehouses     warehouses?    @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)
  return_items   return_items[]
  credit_notes   credit_notes[]

  @@unique([company_id, rma_number], map: "return_requests_company_number_unique")
  @@index([company_id, status], map: "idx_return_requests_company_status")
}

model return_items {
  id                BigInt          @id @default(autoincrement())
  return_id         BigInt
  order_item_id     BigInt
  product_id        BigInt?
  quantity          Int
  quantity_received Int             @default(0)
  condition         String?         @db.VarChar(32)
  restock           Boolean         @default(true)
  return_requests   return_requests @relation(fields: [return_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items       order_items     @relation(fields: [order_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products?       @relation(fields: [product_id], references: [id], onUpdate: NoAction)
}

model credit_notes {
  id                 BigInt              @id @default(autoincrement())
  company_id         BigInt
  user_id            BigInt?
  invoice_id         BigInt?
  return_id          BigInt?
  credit_note_number String              @db.VarChar(32)
