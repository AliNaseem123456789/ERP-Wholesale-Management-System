model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  company_id BigInt?
  type       String    @db.VarChar(48)
  title      String    @db.VarChar(255)
  body       String?   @db.VarChar(1000)
  link       String?   @db.VarChar(500)
  dedupe_key String?   @db.VarChar(160)
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user")
}

model compliance_rules {
  id               BigInt   @id @default(autoincrement())
  company_id       BigInt
  state            String   @db.VarChar(2)
  category         String   @default("*") @db.VarChar(32)
  tax_type         String   @default("none") @db.VarChar(16)
  tax_rate         Decimal  @default(0) @db.Decimal(12, 4)
  flavor_ban       Boolean  @default(false)
  license_required Boolean  @default(false)
  ship_banned      Boolean  @default(false)
  age_verification Boolean  @default(false)
  report_shipments Boolean  @default(false)
  notes            String?  @db.VarChar(1000)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([company_id, state, category], map: "compliance_rules_unique")
}

model customer_licenses {
  id             BigInt    @id @default(autoincrement())
  company_id     BigInt
  user_id        BigInt
  state          String    @db.VarChar(2)
  license_number String    @db.VarChar(128)
  expires_on     DateTime? @db.Date
  notes          String?   @db.VarChar(500)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([company_id, user_id, state], map: "customer_licenses_unique")
}

model report_schedules {
  id           BigInt    @id @default(autoincrement())
  company_id   BigInt
  name         String    @db.VarChar(255)
  report       String    @db.VarChar(48)
  frequency    String    @db.VarChar(16)
  day_of_week  Int?
  day_of_month Int?
  hour         Int       @default(8)
  timezone     String    @default("UTC") @db.VarChar(64)
  recipients   String[]  @default([])
  is_active    Boolean   @default(true)
  next_run_at  DateTime? @db.Timestamptz(6)
  last_run_at  DateTime? @db.Timestamptz(6)
  created_by   BigInt?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
}

model report_runs {
  id          BigInt    @id @default(autoincrement())
  company_id  BigInt
  schedule_id BigInt?
  report      String    @db.VarChar(48)
  title       String    @db.VarChar(255)
  period_from DateTime? @db.Date
  period_to   DateTime? @db.Date
  row_count   Int       @default(0)
  csv         String    @default("")
  summary     Json      @default("[]")
  status      String    @default("ok") @db.VarChar(16)
  error       String?
  recipients  String[]  @default([])
  created_by  BigInt?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([company_id, created_at(sort: Desc)], map: "idx_report_runs_company")
}

// ---------------------------------------------------------------------------------------------
// 008_catalogue.sql
// Expression indexes that Prisma can't describe (they exist in the database):
//   categories(COALESCE(parent_id,0), lower(name)) unique, brands(lower(btrim(name))) unique,
//   attribute_definitions(COALESCE(company_id,0), key) unique, attribute_options(attribute_id, lower(value)) unique,
//   product_attribute_values(product_id, COALESCE(variant_id,0), attribute_id, COALESCE(option_id,0)) unique
// ---------------------------------------------------------------------------------------------

model product_images {
  id           BigInt   @id @default(autoincrement())
  product_id   BigInt
  variant_key  String?  @db.VarChar(255)
  url          String   @db.VarChar(1000)
  storage_path String?  @db.VarChar(500)
  alt_text     String?  @db.VarChar(255)
  sort_order   Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id, sort_order], map: "idx_product_images_product")
}

model product_visible_groups {
  product_id        BigInt
  customer_group_id BigInt
  products          products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_groups   customer_groups @relation(fields: [customer_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, customer_group_id])
}

model categories {
  id                    BigInt                @id @default(autoincrement())
  name                  String                @db.VarChar(255)
  slug                  String                @unique(map: "categories_slug_unique") @db.VarChar(255)
  parent_id             BigInt?
  description           String?
  image_url             String?               @db.VarChar(1000)
  is_featured           Boolean               @default(false)
  sort_order            Int                   @default(0)
  /// active | hidden
  status                String                @default("active") @db.VarChar(16)
  created_by_company_id BigInt?
  created_by            BigInt?
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at            DateTime              @default(now()) @db.Timestamptz(6)
  parent                categories?           @relation("category_tree", fields: [parent_id], references: [id], onUpdate: NoAction)
  children              categories[]          @relation("category_tree")
  companies             companies?            @relation(fields: [created_by_company_id], references: [id], onUpdate: NoAction)
  users                 users?                @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  product_categories    product_categories[]
  category_attributes   category_attributes[]

  @@index([parent_id], map: "idx_categories_parent")
}

model product_categories {
  product_id  BigInt
  category_id BigInt
  sort_order  Int        @default(0)
  products    products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, category_id])
  @@index([category_id], map: "idx_product_categories_category")
}

/// relationship: manufacturer | authorized_distributor | distributor | reseller
model company_brands {
  company_id   BigInt
  brand_id     BigInt
  relationship String    @default("reseller") @db.VarChar(32)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  companies    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  brands       brands    @relation(fields: [brand_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([company_id, brand_id])
  @@index([brand_id], map: "idx_company_brands_brand")
}

model attribute_definitions {
  id                       BigInt                     @id @default(autoincrement())
  company_id               BigInt?
  key                      String                     @db.VarChar(64)
  name                     String                     @db.VarChar(255)
  description              String?                    @db.VarChar(500)
  /// text | number | boolean | date | select | multiselect
  data_type                String                     @db.VarChar(16)
  unit                     String?                    @db.VarChar(32)
  validation               Json                       @default("{}")
  /// product | variant | both
  scope                    String                     @default("product") @db.VarChar(16)
  is_variant_option        Boolean                    @default(false)
  is_filterable            Boolean                    @default(false)
  is_searchable            Boolean                    @default(false)
  is_public                Boolean                    @default(true)
  sort_order               Int                        @default(0)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  companies                companies?                 @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_options        attribute_options[]
  category_attributes      category_attributes[]
  product_attribute_values product_attribute_values[]
}

model attribute_options {
  id                       BigInt                     @id @default(autoincrement())
  attribute_id             BigInt
  value                    String                     @db.VarChar(255)
  sort_order               Int                        @default(0)
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  attribute_definitions    attribute_definitions      @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_attribute_values product_attribute_values[]
}

model category_attributes {
  category_id           BigInt
  attribute_id          BigInt
  is_required           Boolean               @default(false)
  sort_order            Int                   @default(0)
  categories            categories            @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_definitions attribute_definitions @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([category_id, attribute_id])
}

model product_attribute_values {
  id                    BigInt                @id @default(autoincrement())
  product_id            BigInt
  variant_id            BigInt?
  attribute_id          BigInt
  option_id             BigInt?
  value_text            String?
  value_number          Decimal?              @db.Decimal(38, 6)
  value_boolean         Boolean?
  value_date            DateTime?             @db.Date
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  products              products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants      product_variants?     @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_definitions attribute_definitions @relation(fields: [attribute_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute_options     attribute_options?    @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attribute_id, option_id], map: "idx_pav_option")
  @@index([attribute_id, value_number], map: "idx_pav_number")
  @@index([variant_id], map: "idx_pav_variant")
}

// ---------------------------------------------------------------------------------------------
// 009_marketplace.sql  (created_by / published_by / updated_by reference users; relations not modelled)
// Expression index: collections(COALESCE(company_id,0), slug) unique
// ---------------------------------------------------------------------------------------------

/// company_id NULL = platform (global) collection. status: draft | published. mode: manual | rules
model collections {
  id                  BigInt                @id @default(autoincrement())
  company_id          BigInt?
  name                String                @db.VarChar(255)
  slug                String                @db.VarChar(255)
  description         String?
  cover_image_url     String?               @db.VarChar(1000)
  mode                String                @default("manual") @db.VarChar(16)
  rules               Json                  @default("{}")
  status              String                @default("draft") @db.VarChar(16)
  is_enabled          Boolean               @default(true)
  starts_at           DateTime?             @db.Timestamptz(6)
  ends_at             DateTime?             @db.Timestamptz(6)
  sort_order          Int                   @default(0)
  created_by          BigInt?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  companies           companies?            @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collection_products collection_products[]

  @@index([company_id, status], map: "idx_collections_company")
}

model collection_products {
  collection_id BigInt
  product_id    BigInt
  sort_order    Int         @default(0)
  collections   collections @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products      products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([collection_id, product_id])
  @@index([product_id], map: "idx_collection_products_product")
}

/// draft / published: { theme, colors, sections: [...] } validated by src/services/storefront.js
model storefronts {
  company_id        BigInt    @id
  draft             Json      @default("{}")
  published         Json?
  published_version Int       @default(0)
  published_at      DateTime? @db.Timestamptz(6)
  published_by      BigInt?
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_by        BigInt?
  companies         companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model storefront_versions {
  id           BigInt    @id @default(autoincrement())
  company_id   BigInt
  version      Int
  config       Json
  published_by BigInt?
  published_at DateTime  @default(now()) @db.Timestamptz(6)
  companies    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([company_id, version], map: "storefront_versions_unique")
}

// ---------------------------------------------------------------------------------------------
// 010_buying.sql  (address columns reference addresses; relations not modelled)
// Partial indexes: carts(user_id) unique WHERE is_default; recurring_orders(next_run_on) WHERE status='active';
//                  stock_alerts(product_id) WHERE notified_at IS NULL
// ---------------------------------------------------------------------------------------------

model carts {
  id         BigInt       @id @default(autoincrement())
  user_id    BigInt
  name       String       @default("Main cart") @db.VarChar(120)
  notes      String?      @db.VarChar(500)
  address_id BigInt?
  is_default Boolean      @default(false)
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime     @default(now()) @db.Timestamptz(6)
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cart_items cart_items[]

  @@index([user_id], map: "idx_carts_user")
}

/// frequency: weekly | biweekly | monthly. mode: auto | review. status: active | paused | cancelled
model recurring_orders {
  id                    BigInt                  @id @default(autoincrement())
  user_id               BigInt
  name                  String                  @db.VarChar(120)
  frequency             String                  @db.VarChar(16)
  day_of_week           Int?
  day_of_month          Int?
  next_run_on           DateTime                @db.Date
  mode                  String                  @default("review") @db.VarChar(16)
  status                String                  @default("active") @db.VarChar(16)
  shipping_address_id   BigInt?
  billing_address_id    BigInt?
  payment_methods       Json                    @default("{}")
  skip_next             Boolean                 @default(false)
  last_run_at           DateTime?               @db.Timestamptz(6)
  last_result           Json?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recurring_order_items recurring_order_items[]
  orders                orders[]

  @@index([user_id], map: "idx_recurring_orders_user")
}

model recurring_order_items {
  id                 BigInt           @id @default(autoincrement())
  recurring_order_id BigInt
  product_id         BigInt
  flavor             String           @default("") @db.VarChar(255)
  quantity           Int
  recurring_orders   recurring_orders @relation(fields: [recurring_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recurring_order_id], map: "idx_recurring_order_items_order")
}

model stock_alerts {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  product_id  BigInt
  flavor      String    @default("") @db.VarChar(255)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  notified_at DateTime? @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id, flavor], map: "stock_alerts_unique")
}

// ---------------------------------------------------------------------------------------------
// 011_quotes.sql  (quote_versions.created_by / quote_messages.author_id reference users; relations not modelled)
// ---------------------------------------------------------------------------------------------

/// status: open | awarded | closed | cancelled
model rfqs {
  id               BigInt      @id @default(autoincrement())
  user_id          BigInt
  rfq_number       String      @unique(map: "rfqs_number_unique") @db.VarChar(32)
  title            String      @db.VarChar(255)
  notes            String?
  needed_by        DateTime?   @db.Date
  status           String      @default("open") @db.VarChar(16)
  awarded_quote_id BigInt?
  created_at       DateTime    @default(now()) @db.Timestamptz(6)
  updated_at       DateTime    @default(now()) @db.Timestamptz(6)
  users            users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rfq_items        rfq_items[]
  quotes           quotes[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_rfqs_user")
}

model rfq_items {
  id          BigInt    @id @default(autoincrement())
  rfq_id      BigInt
  description String    @db.VarChar(500)
  quantity    Int
  product_id  BigInt?
  flavor      String    @default("") @db.VarChar(255)
  sort_order  Int       @default(0)
  rfqs        rfqs      @relation(fields: [rfq_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([rfq_id], map: "idx_rfq_items_rfq")
}

model quote_versions {
  id         BigInt   @id @default(autoincrement())
  quote_id   BigInt
  version    Int
  snapshot   Json
  created_by BigInt?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  quotes     quotes   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([quote_id, version], map: "quote_versions_unique")
}

/// author_side: customer | seller. proposal: { lines: [{ item_id, quantity?, unit_price? }], total? }
model quote_messages {
  id          BigInt   @id @default(autoincrement())
  quote_id    BigInt
  author_side String   @db.VarChar(16)
  author_id   BigInt?
  body        String?
  proposal    Json?
  version     Int?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  quotes      quotes   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quote_id, created_at], map: "idx_quote_messages_quote")
}
