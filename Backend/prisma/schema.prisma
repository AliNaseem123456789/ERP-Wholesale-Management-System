  @@index([invoice_id], map: "idx_credit_notes_invoice")
}

model credit_note_items {
  id             BigInt       @id @default(autoincrement())
  credit_note_id BigInt
  product_id     BigInt?
  description    String       @db.VarChar(500)
  quantity       Int
  unit_price     Decimal      @db.Decimal(38, 4)
  line_total     Decimal      @db.Decimal(38, 2)
  credit_notes   credit_notes @relation(fields: [credit_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products?    @relation(fields: [product_id], references: [id], onUpdate: NoAction)
}

model quotes {
  id              BigInt        @id @default(autoincrement())
  excise_amount  Decimal  @default(0) @db.Decimal(38, 2)
  company_id      BigInt
  user_id         BigInt
  quote_number    String        @db.VarChar(32)
  status          String        @default("draft") @db.VarChar(32)
  valid_until     DateTime?     @db.Date
  subtotal        Decimal       @default(0) @db.Decimal(38, 2)
  discount_amount Decimal       @default(0) @db.Decimal(38, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(38, 2)
  shipping_amount Decimal       @default(0) @db.Decimal(38, 2)
  total_amount    Decimal       @default(0) @db.Decimal(38, 2)
  customer_notes  String?
  notes           String?
  order_id        BigInt?
  sent_at         DateTime?     @db.Timestamptz(6)
  accepted_at     DateTime?     @db.Timestamptz(6)
  created_by      BigInt?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime      @default(now()) @db.Timestamptz(6)
  companies       companies     @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders          orders?       @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  quote_items     quote_items[]
  rfq_id                  BigInt?
  version                 Int              @default(0)
  lead_time_days          Int?
  follow_up_sent_at       DateTime?        @db.Timestamptz(6)
  expiry_reminder_sent_at DateTime?        @db.Timestamptz(6)
  countered_at            DateTime?        @db.Timestamptz(6)
  rfqs                    rfqs?            @relation(fields: [rfq_id], references: [id], onUpdate: NoAction)
  quote_versions          quote_versions[]
  quote_messages          quote_messages[]

  @@unique([company_id, quote_number], map: "quotes_company_number_unique")
  @@index([company_id, status], map: "idx_quotes_company_status")
  @@index([user_id], map: "idx_quotes_user")
  @@index([rfq_id], map: "idx_quotes_rfq")
}

model quote_items {
  id          BigInt   @id @default(autoincrement())
  quote_id    BigInt
  product_id  BigInt
  description String?  @db.VarChar(500)
  quantity    Int
  flavor       String     @default("") @db.VarChar(255)
  unit_price  Decimal  @default(0) @db.Decimal(38, 4)
  line_total  Decimal  @default(0) @db.Decimal(38, 2)
  quotes      quotes   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


/// One row per purchasable variant. `flavor` is the variant key used by stock, carts, orders and every
/// other stock table; it never changes once the variant has stock or history (`name` is the display label).
model product_variants {
  id            BigInt   @id @default(autoincrement())
  product_id    BigInt
  flavor        String   @db.VarChar(255)
  sku           String?  @db.VarChar(255)
  barcode       String?  @db.VarChar(64)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  name          String?  @db.VarChar(255)
  price         Decimal? @db.Decimal(38, 2)
  cost_price    Decimal? @db.Decimal(38, 4)
  /// active | discontinued | archived
  status        String   @default("active") @db.VarChar(16)
  min_order_qty Int?
  image_url     String?  @db.VarChar(1000)
  sort_order    Int      @default(0)
  products      products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_attribute_values product_attribute_values[]

  @@unique([product_id, flavor], map: "product_variants_product_flavor_unique")
  @@index([barcode], map: "idx_product_variants_barcode")
  @@index([sku], map: "idx_product_variants_sku")
}

model supplier_returns {
  id                    BigInt                  @id @default(autoincrement())
  company_id            BigInt
  supplier_id           BigInt
  warehouse_id          BigInt
  purchase_order_id     BigInt?
  return_number         String                  @db.VarChar(32)
  status                String                  @default("draft") @db.VarChar(32)
  reason                String                  @db.VarChar(64)
  notes                 String?
  total_amount          Decimal                 @default(0) @db.Decimal(38, 2)
  credit_amount         Decimal?                @db.Decimal(38, 2)
  credit_reference      String?                 @db.VarChar(255)
  shipped_at            DateTime?               @db.Timestamptz(6)
  credited_at           DateTime?               @db.Timestamptz(6)
  created_by            BigInt?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  companies             companies               @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  suppliers             suppliers               @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses            warehouses              @relation(fields: [warehouse_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders       purchase_orders?        @relation(fields: [purchase_order_id], references: [id], onUpdate: NoAction)
  supplier_return_items supplier_return_items[]

  @@unique([company_id, return_number], map: "supplier_returns_company_number_unique")
  @@index([company_id, status], map: "idx_supplier_returns_company_status")
  @@index([supplier_id], map: "idx_supplier_returns_supplier")
}

model supplier_return_items {
  id                 BigInt           @id @default(autoincrement())
  supplier_return_id BigInt
  product_id         BigInt
  flavor             String           @default("") @db.VarChar(255)
  lot_id             BigInt?
  quantity           Int
  unit_cost          Decimal          @default(0) @db.Decimal(38, 4)
  line_total         Decimal          @default(0) @db.Decimal(38, 2)
  supplier_returns   supplier_returns @relation(fields: [supplier_return_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_lots     inventory_lots?  @relation(fields: [lot_id], references: [id], onUpdate: NoAction)
}

model accounts {
  id                   BigInt                 @id @default(autoincrement())
  company_id           BigInt
  code                 String                 @db.VarChar(16)
  name                 String                 @db.VarChar(255)
  type                 String                 @db.VarChar(16)
  subtype              String                 @db.VarChar(32)
  system_key           String?                @db.VarChar(32)
  description          String?
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  journal_lines        journal_lines[]
  bill_items           bill_items[]
  bill_payments        bill_payments[]
  expenses             expenses[]             @relation("expense_account")
  expenses_paid_from   expenses[]             @relation("expense_paid_from")
  bank_reconciliations bank_reconciliations[]

  @@unique([company_id, code], map: "accounts_company_code_unique")
}

model journal_entries {
  id             BigInt          @id @default(autoincrement())
  company_id     BigInt
  entry_number   String          @db.VarChar(32)
  entry_date     DateTime        @db.Date
  memo           String?         @db.VarChar(500)
  source_type    String          @db.VarChar(32)
  source_id      String?         @db.VarChar(64)
  reversal_of_id BigInt?
  reversed       Boolean         @default(false)
  total          Decimal         @default(0) @db.Decimal(38, 2)
  created_by     BigInt?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  journal_lines  journal_lines[]

  @@unique([company_id, entry_number], map: "journal_entries_company_number_unique")
  @@index([company_id, entry_date], map: "idx_journal_entries_company_date")
  @@index([company_id, source_type, source_id], map: "idx_journal_entries_source")
}

model journal_lines {
  id                BigInt          @id @default(autoincrement())
  entry_id          BigInt
  company_id        BigInt
  account_id        BigInt
  debit             Decimal         @default(0) @db.Decimal(38, 2)
  credit            Decimal         @default(0) @db.Decimal(38, 2)
  description       String?         @db.VarChar(500)
  customer_id       BigInt?
  supplier_id       BigInt?
  cleared           Boolean         @default(false)
  reconciliation_id BigInt?
  journal_entries   journal_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts          accounts        @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entry_id], map: "idx_journal_lines_entry")
  @@index([company_id, account_id], map: "idx_journal_lines_company_account")
}

model bills {
  id                         BigInt                       @id @default(autoincrement())
  company_id                 BigInt
  supplier_id                BigInt
  purchase_order_id          BigInt?
  bill_number                String                       @db.VarChar(32)
  supplier_invoice_number    String?                      @db.VarChar(255)
  status                     String                       @default("open") @db.VarChar(32)
  bill_date                  DateTime                     @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date                   DateTime                     @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_amount               Decimal                      @default(0) @db.Decimal(38, 2)
  amount_paid                Decimal                      @default(0) @db.Decimal(38, 2)
  amount_credited            Decimal                      @default(0) @db.Decimal(38, 2)
  notes                      String?
  created_by                 BigInt?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  voided_at                  DateTime?                    @db.Timestamptz(6)
  suppliers                  suppliers                    @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bill_items                 bill_items[]
  bill_payments              bill_payments[]
  vendor_credit_applications vendor_credit_applications[]

  @@unique([company_id, bill_number], map: "bills_company_number_unique")
  @@index([company_id, status], map: "idx_bills_company_status")
  @@index([supplier_id], map: "idx_bills_supplier")
}

model bill_items {
  id          BigInt    @id @default(autoincrement())
  bill_id     BigInt
  account_id  BigInt
  product_id  BigInt?
  description String    @db.VarChar(500)
  quantity    Decimal   @default(1) @db.Decimal(38, 4)
  unit_cost   Decimal   @default(0) @db.Decimal(38, 4)
  line_total  Decimal   @default(0) @db.Decimal(38, 2)
  bills       bills     @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts    accounts  @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)
}

model bill_payments {
  id          BigInt   @id @default(autoincrement())
  company_id  BigInt
  bill_id     BigInt
  account_id  BigInt
  amount      Decimal  @db.Decimal(38, 2)
  method      String   @db.VarChar(32)
  reference   String?  @db.VarChar(255)
  paid_at     DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  notes       String?
  recorded_by BigInt?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  bills       bills    @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts    accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([bill_id], map: "idx_bill_payments_bill")
}

model vendor_credits {
  id                         BigInt                       @id @default(autoincrement())
  company_id                 BigInt
  supplier_id                BigInt
  supplier_return_id         BigInt?
  credit_number              String                       @db.VarChar(32)
  reference                  String?                      @db.VarChar(255)
  credit_date                DateTime                     @default(dbgenerated("CURRENT_DATE")) @db.Date
  amount                     Decimal                      @db.Decimal(38, 2)
  amount_applied             Decimal                      @default(0) @db.Decimal(38, 2)
  status                     String                       @default("open") @db.VarChar(32)
  notes                      String?
  created_by                 BigInt?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  suppliers                  suppliers                    @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor_credit_applications vendor_credit_applications[]

  @@unique([company_id, credit_number], map: "vendor_credits_company_number_unique")
}

model vendor_credit_applications {
  id               BigInt         @id @default(autoincrement())
  vendor_credit_id BigInt
  bill_id          BigInt
  amount           Decimal        @db.Decimal(38, 2)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  vendor_credits   vendor_credits @relation(fields: [vendor_credit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bills            bills          @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model expenses {
  id                   BigInt   @id @default(autoincrement())
  company_id           BigInt
  expense_number       String   @db.VarChar(32)
  expense_date         DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  payee                String   @db.VarChar(255)
  account_id           BigInt
  paid_from_account_id BigInt
  supplier_id          BigInt?
  amount               Decimal  @db.Decimal(38, 2)
  method               String?  @db.VarChar(32)
  reference            String?  @db.VarChar(255)
  notes                String?
  status               String   @default("posted") @db.VarChar(16)
  created_by           BigInt?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  accounts             accounts @relation("expense_account", fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paid_from            accounts @relation("expense_paid_from", fields: [paid_from_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, expense_number], map: "expenses_company_number_unique")
  @@index([company_id, expense_date], map: "idx_expenses_company_date")
}

model bank_reconciliations {
  id                BigInt   @id @default(autoincrement())
  company_id        BigInt
  account_id        BigInt
  statement_date    DateTime @db.Date
  statement_balance Decimal  @db.Decimal(38, 2)
  cleared_balance   Decimal  @db.Decimal(38, 2)
  lines_cleared     Int      @default(0)
  notes             String?
  created_by        BigInt?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  accounts          accounts @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([account_id], map: "idx_bank_reconciliations_account")
}

// ---------------------------------------------------------------------------
// Phase 5: HR & payroll (prisma/sql/006_hr_payroll.sql)
// ---------------------------------------------------------------------------

model departments {
  id                  BigInt      @id @default(autoincrement())
  company_id          BigInt
  name                String      @db.VarChar(255)
  code                String?     @db.VarChar(32)
  description         String?
  manager_employee_id BigInt?
  is_active           Boolean     @default(true)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @default(now()) @db.Timestamptz(6)
  manager             employees?  @relation("department_manager", fields: [manager_employee_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "departments_manager_fk")
  employees           employees[] @relation("employee_department")

  @@unique([company_id, name], map: "departments_company_name_unique")
}

model employees {
  id                      BigInt                    @id @default(autoincrement())
  company_id              BigInt
  user_id                 BigInt?
  employee_number         String                    @db.VarChar(32)
  first_name              String                    @db.VarChar(255)
  last_name               String?                   @db.VarChar(255)
  email                   String?                   @db.VarChar(255)
  phone                   String?                   @db.VarChar(64)
  department_id           BigInt?
  job_title               String?                   @db.VarChar(255)
  employment_type         String                    @default("full_time") @db.VarChar(16)
  status                  String                    @default("active") @db.VarChar(16)
  hire_date               DateTime                  @default(dbgenerated("CURRENT_DATE")) @db.Date
  termination_date        DateTime?                 @db.Date
  date_of_birth           DateTime?                 @db.Date
  national_id             String?                   @db.VarChar(64)
  tax_number              String?                   @db.VarChar(64)
  address                 String?
  emergency_contact_name  String?                   @db.VarChar(255)
  emergency_contact_phone String?                   @db.VarChar(64)
  pay_type                String                    @default("salary") @db.VarChar(16)
  base_salary             Decimal                   @default(0) @db.Decimal(38, 2)
  hourly_rate             Decimal                   @default(0) @db.Decimal(38, 4)
  payment_method          String                    @default("bank_transfer") @db.VarChar(16)
  bank_name               String?                   @db.VarChar(255)
  bank_account_number     String?                   @db.VarChar(64)
  bank_routing            String?                   @db.VarChar(64)
  notes                   String?
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  departments             departments?              @relation("employee_department", fields: [department_id], references: [id], onUpdate: NoAction)
  managed_departments     departments[]             @relation("department_manager")
  employee_pay_components employee_pay_components[]
  leave_requests          leave_requests[]
  attendance              attendance[]
  payslips                payslips[]

  @@unique([company_id, employee_number], map: "employees_company_number_unique")
  @@index([company_id, status], map: "idx_employees_company_status")
}

model pay_components {
  id                      BigInt                    @id @default(autoincrement())
  company_id              BigInt
  code                    String                    @db.VarChar(32)
  name                    String                    @db.VarChar(255)
  kind                    String                    @db.VarChar(16)
  calc                    String                    @default("fixed") @db.VarChar(16)
  amount                  Decimal                   @default(0) @db.Decimal(38, 2)
  percent                 Decimal                   @default(0) @db.Decimal(9, 4)
  taxable                 Boolean                   @default(true)
  applies_to_all          Boolean                   @default(false)
  account_id              BigInt?
  is_active               Boolean                   @default(true)
  sort_order              Int                       @default(0)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  employee_pay_components employee_pay_components[]

  @@unique([company_id, code], map: "pay_components_company_code_unique")
}

model employee_pay_components {
  id             BigInt         @id @default(autoincrement())
  employee_id    BigInt
  component_id   BigInt
  amount         Decimal?       @db.Decimal(38, 2)
  percent        Decimal?       @db.Decimal(9, 4)
  excluded       Boolean        @default(false)
  employees      employees      @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pay_components pay_components @relation(fields: [component_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, component_id], map: "employee_pay_components_unique")
}

model holidays {
  id           BigInt   @id @default(autoincrement())
  company_id   BigInt
  holiday_date DateTime @db.Date
  name         String   @db.VarChar(255)

  @@unique([company_id, holiday_date], map: "holidays_company_date_unique")
}

model leave_types {
  id             BigInt           @id @default(autoincrement())
  company_id     BigInt
  name           String           @db.VarChar(255)
  paid           Boolean          @default(true)
  annual_days    Decimal          @default(0) @db.Decimal(6, 2)
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  leave_requests leave_requests[]

  @@unique([company_id, name], map: "leave_types_company_name_unique")
}

model leave_requests {
  id             BigInt       @id @default(autoincrement())
  company_id     BigInt
  employee_id    BigInt
  leave_type_id  BigInt
  start_date     DateTime     @db.Date
  end_date       DateTime     @db.Date
  half_day       Boolean      @default(false)
  days           Decimal      @default(0) @db.Decimal(6, 2)
  reason         String?
  status         String       @default("pending") @db.VarChar(16)
  requested_by   BigInt?
  decided_by     BigInt?
  decided_at     DateTime?    @db.Timestamptz(6)
  decision_notes String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  employees      employees    @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leave_types    leave_types  @relation(fields: [leave_type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attendance     attendance[]

  @@index([company_id, status], map: "idx_leave_requests_company_status")
  @@index([employee_id, start_date], map: "idx_leave_requests_employee")
}

model attendance {
  id               BigInt          @id @default(autoincrement())
  company_id       BigInt
  employee_id      BigInt
  work_date        DateTime        @db.Date
  status           String          @db.VarChar(16)
  day_units        Decimal         @default(1) @db.Decimal(3, 2)
  check_in         String?         @db.VarChar(5)
  check_out        String?         @db.VarChar(5)
  hours            Decimal?        @db.Decimal(6, 2)
  overtime_hours   Decimal         @default(0) @db.Decimal(6, 2)
  leave_request_id BigInt?
  notes            String?         @db.VarChar(500)
  recorded_by      BigInt?
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  employees        employees       @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leave_requests   leave_requests? @relation(fields: [leave_request_id], references: [id], onUpdate: NoAction)

  @@unique([employee_id, work_date], map: "attendance_employee_date_unique")
  @@index([company_id, work_date], map: "idx_attendance_company_date")
}

model payroll_runs {
  id               BigInt     @id @default(autoincrement())
  company_id       BigInt
  run_number       String     @db.VarChar(32)
  period_start     DateTime   @db.Date
  period_end       DateTime   @db.Date
  pay_date         DateTime   @db.Date
  status           String     @default("draft") @db.VarChar(16)
  employee_count   Int        @default(0)
  total_gross      Decimal    @default(0) @db.Decimal(38, 2)
  total_deductions Decimal    @default(0) @db.Decimal(38, 2)
  total_employer   Decimal    @default(0) @db.Decimal(38, 2)
  total_net        Decimal    @default(0) @db.Decimal(38, 2)
  notes            String?
  paid_account_id  BigInt?
  paid_reference   String?    @db.VarChar(255)
  created_by       BigInt?
  approved_by      BigInt?
  approved_at      DateTime?  @db.Timestamptz(6)
  paid_at          DateTime?  @db.Date
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  payslips         payslips[]

  @@unique([company_id, run_number], map: "payroll_runs_company_number_unique")
}

model payslips {
  id               BigInt          @id @default(autoincrement())
  company_id       BigInt
  payroll_run_id   BigInt
  employee_id      BigInt
  payslip_number   String          @db.VarChar(48)
  working_days     Decimal         @default(0) @db.Decimal(6, 2)
  paid_days        Decimal         @default(0) @db.Decimal(6, 2)
  unpaid_days      Decimal         @default(0) @db.Decimal(6, 2)
  hours_worked     Decimal         @default(0) @db.Decimal(8, 2)
  overtime_hours   Decimal         @default(0) @db.Decimal(8, 2)
  gross            Decimal         @default(0) @db.Decimal(38, 2)
  taxable          Decimal         @default(0) @db.Decimal(38, 2)
  total_deductions Decimal         @default(0) @db.Decimal(38, 2)
  employer_total   Decimal         @default(0) @db.Decimal(38, 2)
  net              Decimal         @default(0) @db.Decimal(38, 2)
  snapshot         Json            @default("{}")
  warnings         Json            @default("[]")
  emailed_at       DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  payroll_runs     payroll_runs    @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees        employees       @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payslip_lines    payslip_lines[]

  @@unique([payroll_run_id, employee_id], map: "payslips_run_employee_unique")
  @@index([employee_id], map: "idx_payslips_employee")
}

model payslip_lines {
  id           BigInt   @id @default(autoincrement())
  payslip_id   BigInt
  component_id BigInt?
  kind         String   @db.VarChar(16)
  code         String?  @db.VarChar(32)
  name         String   @db.VarChar(255)
  amount       Decimal  @db.Decimal(38, 2)
  taxable      Boolean  @default(false)
  account_id   BigInt?
  is_manual    Boolean  @default(false)
  sort_order   Int      @default(0)
  payslips     payslips @relation(fields: [payslip_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payslip_id], map: "idx_payslip_lines_payslip")
}

// ---------------------------------------------------------------------------
// Operations (prisma/sql/007_operations.sql)
