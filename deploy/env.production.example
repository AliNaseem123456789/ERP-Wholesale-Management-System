# Backend/.env on the server. Copy the secret values from your current Backend/.env.
NODE_ENV=production
PORT=5000

# Amazon RDS (see deploy/README.md step 4). sslaccept: the connection is encrypted; RDS's certificate isn't
# in the system's trust store, and the database is only reachable from inside the VPC.
DATABASE_URL=postgresql://wholesale_admin:CHANGE_ME@CHANGE_ME.ap-south-1.rds.amazonaws.com:5432/wholesale?sslmode=require&sslaccept=accept_invalid_certs&connection_limit=10

# keep these the same as now, so people stay logged in after the move
JWT_SECRET=
JWT_REFRESH_SECRET=

# pictures stay in Supabase storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# the website (emails link to it; it calls the API through its /api rewrite)
APP_URL=https://smoke-wholesale.vercel.app
APP_NAME=Smoke Wholesale
CORS_ORIGINS=https://smoke-wholesale.vercel.app,http://localhost:5173

# email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# visitors reach the API through Vercel's /api rewrite and nginx: two proxies
TRUST_PROXY=2
# log only slow requests (ms); REQUEST_LOG=off to switch the request log off
REQUEST_LOG=on
REQUEST_LOG_SLOW=500
