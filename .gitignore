# Dependencies
node_modules/

# Environment files (secrets). The .env.example files are committed.
.env
.env.*
!.env.example

# Build output
dist/
build/
out/

# Local database exports and code backups (may contain customer data)
Backend/backups/
_backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Demo pictures copied here by `npm run demo:data -- --apply` when Supabase isn't set up
Frontend/public/demo/

# Safety snapshots written by the database scripts
Backend/before-*.json

# Rendered demo pictures (packed into scripts/demo/data/images.pack.gz)
Backend/scripts/demo/images/

# Real photos downloaded by `npm run demo:photos` (Pexels licence: use, but not re-sell or re-host as a collection)
Backend/scripts/demo/photos/
Frontend/public/demo-photos/

# Speed test results (npm run loadtest:get)
Backend/loadtest-reports/
